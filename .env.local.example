# Template do perfil "local pessoal" do Klipper.
# Copiar para .env.local (já ignorado pelo git) e preencher com valores reais:
#   cp .env.local.example .env.local
#
# ATENÇÃO: bin/docker-entrypoint roda `rails db:prepare` a cada boot do
# container `api`, contra o DATABASE_URL montado a partir de POSTGRES_PASSWORD
# abaixo. Um valor errado aqui é o maior risco deste desenho assim que este
# perfil passar a guardar dado financeiro real — confira antes de subir.

# Gerar com: openssl rand -hex 24
# Não reaproveitar o "postgres/postgres" do docker-compose.yml de dev.
POSTGRES_PASSWORD=

# Copiar de apps/klipper-api/config/master.key (já existe, é local).
RAILS_MASTER_KEY=
